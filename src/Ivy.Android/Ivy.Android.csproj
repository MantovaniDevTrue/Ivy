<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <ApplicationId>dev.mantovani.ivy</ApplicationId>
    <ApplicationTitle>Ivy</ApplicationTitle>
    <ApplicationVersion>4</ApplicationVersion>
    <ApplicationDisplayVersion>0.2.1</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <PublishTrimmed>false</PublishTrimmed>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Ivy.Core/Ivy.Core.csproj" />
    <AndroidAsset Include="../../samples/ExampleMod/bin/$(Configuration)/net10.0/ExampleMod.dll" Link="ExampleMod.dll" />
  </ItemGroup>
</Project>
