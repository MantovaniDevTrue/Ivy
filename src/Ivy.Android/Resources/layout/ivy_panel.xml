<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:fitsSystemWindows="true" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ivy_canvas" android:paddingLeft="16dp" android:paddingRight="16dp">
  <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="76dp" android:paddingLeft="4dp" android:paddingRight="4dp">
    <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ivy_leaf" android:contentDescription="Ivy"/>
    <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginLeft="12dp"><TextView android:text="@string/ivy_title" android:textColor="@color/ivy_text" android:textSize="22sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/><TextView android:text="TERRARIA · ANDROID" android:textColor="@color/ivy_muted" android:textSize="10sp" android:letterSpacing="0.12" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
    <TextView android:id="@+id/ivy_version" android:textColor="@color/ivy_muted" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  </LinearLayout>
  <FrameLayout android:id="@+id/ivy_content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
  <TextView android:id="@+id/ivy_status" android:text="@string/ivy_ready" android:textColor="@color/ivy_muted" android:textSize="12sp" android:padding="8dp" android:maxLines="3" android:ellipsize="end" android:layout_width="match_parent" android:layout_height="wrap_content"/>
  <LinearLayout android:id="@+id/ivy_navigation" android:orientation="horizontal" android:gravity="center" android:paddingBottom="8dp" android:layout_width="match_parent" android:layout_height="64dp"/>
</LinearLayout>
